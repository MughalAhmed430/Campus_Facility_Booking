# Copy this file to server/.env and fill in real values. Never commit server/.env.
#   Copy-Item server\.env.example server\.env

# development | production
NODE_ENV=development

# Port the Express server listens on.
PORT=3000

# PostgreSQL connection string.
# Hosted databases need SSL: keep ?sslmode=require at the end.
# A local PostgreSQL install usually has no SSL: remove ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Comma-separated origins allowed to call the API from a different origin,
# e.g. http://localhost:5500 for VS Code Live Server.
# Leave empty when you open the app through this server (http://localhost:3000).
CORS_ORIGINS=

# Copy this file to server/.env and fill in real values. Never commit server/.env.
#   Copy-Item server\.env.example server\.env

# development | production
NODE_ENV=development

# Port the Express server listens on.
PORT=3000

# PostgreSQL connection string.
# Hosted databases (e.g. Neon) need SSL: end the URL with ?sslmode=verify-full.
#   If your provider gives you "?sslmode=require&channel_binding=require", replace it
#   with "?sslmode=verify-full". The pg package already treats require as verify-full
#   and prints a security warning otherwise; it ignores channel_binding in the URL.
# A local PostgreSQL install usually has no SSL: remove the ?sslmode=... part.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Comma-separated origins allowed to call the API from a different origin, with the
# session cookie, e.g. http://localhost:5500 for VS Code Live Server.
# Use the same host name as the API: http://localhost:5500 with http://localhost:3000,
# not 127.0.0.1 with localhost. Their fetch calls need credentials: 'include' (see README).
# Leave empty when you open the app through this server (http://localhost:3000).
CORS_ORIGINS=

# Address of the frontend, used to build the link in verification emails
# (<CLIENT_BASE_URL>/pages/verify-email.html?token=...). Leave empty when you open the
# app through this server: it defaults to http://localhost:<PORT>.
# With VS Code Live Server, use http://localhost:5500.
CLIENT_BASE_URL=

# Gmail account that sends verification emails (see README, "Sending email with Gmail").
# Leave both empty to skip sending: the server then prints each verification link to
# its console instead, so you can still verify accounts locally.
# SMTP_USER: the full Gmail address, e.g. yourname@gmail.com
SMTP_USER=
# SMTP_APP_PASSWORD: a 16-character Google *App Password* (Google Account > Security >
# 2-Step Verification > App passwords), NOT your normal Gmail password. Spaces are
# ignored. Keep it only in server/.env: it is never committed or printed in logs.
SMTP_APP_PASSWORD=

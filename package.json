{
  "name": "smart-campus-booking",
  "version": "0.1.0",
  "description": "Smart Campus Facility Booking & Management System - Kyungdong University",
  "private": true,
  "type": "module",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "dev": "nodemon server/src/server.js",
    "db:schema": "node server/src/db/run-sql-file.js database/schema.sql",
    "db:seed": "node server/src/db/run-sql-file.js database/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed"
  },
  "engines": {
    "node": ">=22"
  },
  "nodemonConfig": {
    "watch": [
      "server/src"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
